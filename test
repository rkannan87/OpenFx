4. ChunkGeneratorController.postChunks — simpler than before, no field to set on Job
java
private void postChunks(Job job, Customer cust, EntityManager em) throws JMSException, NamingException {

    List<Chunk> chunks = em.createNamedQuery("chunk.selectByJobId").setParameter(1, job.getId()).getResultList();

    int numPosted = 0;
    int chunkMessageType;

    if (JobConstants.JOBTYPE_REGULAR.equalsIgnoreCase(job.getJobType())) {
        chunkMessageType = BaseMessage.TYPE_DAILY;
    } else if (JobConstants.JOBTYPE_FIRSTTIME.equalsIgnoreCase(job.getJobType())) {
        chunkMessageType = BaseMessage.TYPE_FIRSTTIME;
    } else if (JobConstants.JOBTYPE_ATTPLUS.equalsIgnoreCase(job.getJobType())) {
        chunkMessageType = BaseMessage.TYPE_ATTPLUS;
    } else {
        chunkMessageType = BaseMessage.TYPE_DAILY;
    }

    PanDecryptService decryptService = PanDecryptServiceHolder.getInstance();
    boolean vaultEnabled = (decryptService != null) && decryptService.isEnabled();
    // No generation or persistence needed - every stage derives this
    // independently from job.getId() / cm.getJobId().
    String keyLocation = vaultEnabled ? PanSubstitutionService.deriveKeyLocationForJob(job.getId()) : null;

    for (Chunk chunk : chunks) {

        if ((chunk.getStartIdFid() == 0) && (chunk.getEndIdFid() == 0)) {
            continue;
        }

        ChunkMessage msg = new ChunkMessage();

        msg.setCompany(cust.getCustCode().toLowerCase());
        msg.setCompanyId((int) job.getCustid());
        msg.setJobId(job.getId());
        msg.setChunkId(chunk.getId());
        msg.setType(chunkMessageType);
        msg.setEncPanCsvPath(keyLocation); // kept for backward compatibility with any code still reading it
        poster.postMessage(msg, job.getPriority());

        numPosted++;
    }

    job.setChunks(numPosted);
    em.persist(job);

    log.info("posted {} chunks for customer:{} job:{} with job priority of:{}",
        numPosted, job.getCustid(), job.getId(), job.getPriority());
}
msg.setEncPanCsvPath(keyLocation) is now optional — since every downstream stage can recompute the identical value from cm.getJobId() alone, you don't strictly need to carry it on the message at all. I'd keep setting it anyway for one practical reason: it makes the intent visible when inspecting a ChunkMessage in logs/debugging without having to mentally re-derive it.

