## 7. Stage 5 — `ShipfileBuilderImpl` (assemble shipfile, produce job-level companion CSV)

```java
@Override
public boolean build(Job job, Customer cust, EntityManager em) throws TucException {
    String outFileName;
    boolean shipped;
    try {
        log.info("build ship file for {}", cust.getCustCode());
        long jobNum = job.getId();
        this.currentJobNum = jobNum;
        Path workDir = Paths.get(dirHelper.getAbsoluteFullfillDir(cust.getCustCode(), jobNum));

        if (headertrailer != null && job.getRowCount() > 0) {
            Files.createDirectories(workDir);
            headertrailer.build(job, cust);
        }

        outFileName = dirHelper.getAbsoluteFullfillCompletedDir()
            + cust.getCustCode() + "."
            + DateUtil.getDateString(new Date(), "yyyyMMdd") + "."
            + jobNum + OUT_SUFFIX;

        shipped = assembleShipFile(workDir, jobNum, Paths.get(outFileName));
        log.info("shipped file status {}", shipped);

    } catch (Exception e) {
        log.error("ship file...", e);
        throw new TucException("ship file...", e);
    }

    PanDecryptService decryptService = PanDecryptServiceHolder.getInstance();
    boolean vaultEnabled = (decryptService != null) && decryptService.isEnabled();
    if (shipped && vaultEnabled) {
        generateEncPanCsv(cust.getCustCode(), outFileName, job);
    }
    return true;
}

/**
 * Generate the job-level companion .out.EncPan.csv. Encrypted under a FRESH
 * vaultKeyLocation, distinct from every chunk's own vaultKeyLocation and from
 * the job-wide keyLocation (INDEX scope). Falls back to intermediate-CSV
 * recovery, which now must decrypt each chunk under ITS OWN key before merging.
 */
private void generateEncPanCsv(String custCode, String outFileName, Job job) {
    // job-wide keyLocation must be discoverable here — see Open Item #1
    String keyLocation = resolveJobKeyLocation(job);
    PanDecryptService decryptService = PanDecryptServiceHolder.getInstance();

    Map<String, String> plainPanMap = resolvePlainPanMapForOutput(keyLocation, outFileName);
    if (!plainPanMap.isEmpty()) {
        String vaultKeyLocation = PanSubstitutionService.generateKeyLocation();   // fresh, per-file
        Map<String, String> encryptedMap = buildEncryptedMap(keyLocation, vaultKeyLocation, plainPanMap, decryptService);
        if (!encryptedMap.isEmpty()) {
            writeEncPanCsv(outFileName, keyLocation, vaultKeyLocation, encryptedMap);
            finalizeJob(custCode, keyLocation, null);
            return;
        }
        log.warn("encrypted map empty for [{}], attempting intermediate CSV recovery", keyLocation);
    } else {
        log.warn("warm cache empty for [{}], attempting intermediate CSV recovery", keyLocation);
    }

    recoverFromIntermediateCsvs(custCode, outFileName, keyLocation);
}

private Map<String, String> resolvePlainPanMapForOutput(String keyLocation, String outFileName) {
    Map<String, String> plainPanMap = PanSubstitutionService.buildPlainPanMapForOutput(keyLocation);
    if (plainPanMap.isEmpty()) {
        log.debug("no cached PAN data for [{}], skipping .out.EncPan.csv", keyLocation);
        return plainPanMap;
    }
    plainPanMap = PanSubstitutionService.filterToIndicesPresentInOutput(keyLocation, outFileName, plainPanMap);
    if (plainPanMap.isEmpty()) {
        log.debug("no PAN indices present in output file [{}], skipping .out.EncPan.csv", outFileName);
    }
    return plainPanMap;
}

private Map<String, String> buildEncryptedMap(String keyLocation, String vaultKeyLocation,
                                                Map<String, String> plainPanMap, PanDecryptService decryptService) {
    return PanSubstitutionService.buildOutputCiphertextMap(keyLocation, plainPanMap, vaultKeyLocation, decryptService);
}

private void writeEncPanCsv(String outFileName, String keyLocationForLayout, String vaultKeyLocation,
                             Map<String, String> encryptedMap) {
    int[] outputAccountFieldInfo = PanSubstitutionService.getOutputAccountFieldInfo(keyLocationForLayout);
    String encPanOutPath = outFileName + ".EncPan.csv";
    EncPanCsvWriter.write(encPanOutPath, vaultKeyLocation, encryptedMap, outputAccountFieldInfo);
}

private void finalizeJob(String custCode, String keyLocation, File csvFile) {
    PanSubstitutionService.evict(keyLocation);   // only eviction point in the whole job
    if (csvFile != null) {
        moveEncPanCsvToCompletedDir(csvFile, custCode);
    }
}
```

### Recovery path — must decrypt per-chunk before merging

```java
/**
 * Recover the job-level companion CSV from every chunk's intermediate file.
 * Each chunk's ciphertext is under a DIFFERENT vaultKeyLocation now, so each
 * must be decrypted under its own header key before merging as plaintext.
 * The merged result is re-encrypted once, under one fresh vaultKeyLocation,
 * for the job-level file.
 */
private void recoverFromIntermediateCsvs(String custCode, String outFileName, String keyLocation) {
    String fullfillDir = dirHelper.getAbsoluteFullfillDir(custCode, currentJobNum);
    File dir = new File(fullfillDir);
    File[] intermediates = dir.listFiles((d, name) -> name.endsWith(".txt.EncPan.csv"));

    if (intermediates == null || intermediates.length == 0) {
        log.warn("recovery: no intermediate EncPan CSVs found in [{}], cannot write .out.EncPan.csv", fullfillDir);
        return;
    }
    Arrays.sort(intermediates, Comparator.comparing(File::getName));

    PanDecryptService decryptService = PanDecryptServiceHolder.getInstance();
    Map<String, String> mergedPlainPan = new LinkedHashMap<>();
    EncPanCsvReader reader = new EncPanCsvReader();

    for (File f : intermediates) {
        try {
            PanLookup lookup = reader.parse(f.getAbsolutePath());
            String chunkVaultKeyLocation = lookup.getKeyLocation();   // this chunk's own key
            Map<String, String> chunkCiphertext = lookup.getIndexToEncValue();

            Map<String, String> chunkPlainPan = (decryptService != null)
                ? decryptService.decryptAll(chunkVaultKeyLocation, chunkCiphertext)
                : chunkCiphertext;

            mergedPlainPan.putAll(chunkPlainPan);
            log.info("recovery: decrypted and merged [{}] entries from [{}]", chunkPlainPan.size(), f.getName());
        } catch (Exception e) {
            log.error("recovery: failed to parse/decrypt intermediate CSV [{}], skipping", f.getAbsolutePath(), e);
        }
    }

    if (mergedPlainPan.isEmpty()) {
        log.warn("recovery: all intermediate CSVs empty or failed to parse/decrypt for [{}] job [{}], "
            + "cannot write .out.EncPan.csv", custCode, currentJobNum);
        return;
    }

    String vaultKeyLocation = PanSubstitutionService.generateKeyLocation();
    Map<String, String> reEncrypted = (decryptService != null)
        ? decryptService.encryptAll(vaultKeyLocation, mergedPlainPan)
        : mergedPlainPan;

    String encPanOutPath = outFileName + ".EncPan.csv";
    EncPanCsvWriter.write(encPanOutPath, vaultKeyLocation, reEncrypted, null);
    log.info("recovery: wrote .out.EncPan.csv [{}] with [{}] entries from [{}] intermediate CSV(s)",
        encPanOutPath, reEncrypted.size(), intermediates.length);

    String searchCsvPath = findSearchCsvOnDisk(custCode);
    if (searchCsvPath != null) {
        moveEncPanCsvToCompletedDir(new File(searchCsvPath), custCode);
    } else {
        log.info("recovery: search EncPan CSV not found on disk for [{}], already moved or missing", custCode);
    }
}
```

