private static final String KEY_LOCATION_SALT = "a7f3-genc-dm"; // per-environment constant, not a secret

public static String deriveKeyLocationForJob(long jobId) {
    return KEY_LOCATION_SALT + "-" + jobId;
}
If that's not a concern for your threat model, drop the salt and just use "job-" + jobId.

