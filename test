private static Object processMessage(Message m) throws JMSException {
    Object o = null;

    if (m != null) {
        if (m instanceof TextMessage message) {
            o = message.getText();
        }
        else if (m instanceof ObjectMessage message) {
            try {
                o = message.getObject();   // now protected by the JVM-wide filter set in step 1
            } catch (InvalidClassException e) {
                log.error("Rejected disallowed class during deserialization: " + e.getMessage());
                return null;
            } catch (Exception e) {
                log.error(e.getMessage(), e);
                return null;
            }
        }
        else {
            log.error("Rejected unsupported message type: " + m.getClass().getName());
        }
    }
    return o;
}
