package org.example;

import java.awt.*;
import java.awt.event.KeyEvent;
import java.util.Random;
import java.util.concurrent.TimeUnit;

public class Main {

    private static final int DEFAULT_INTERVAL_MINUTES = 2;
    private static final Random random = new Random();
    private static Robot robot;

    public static void main(String[] args) {
        try {
            int intervalMinutes = DEFAULT_INTERVAL_MINUTES;

            if (args.length > 0) {
                try {
                    intervalMinutes = Integer.parseInt(args[0]);
                    if (intervalMinutes < 1) {
                        System.out.println("Interval must be at least 1 minute. Using default: " + DEFAULT_INTERVAL_MINUTES);
                        intervalMinutes = DEFAULT_INTERVAL_MINUTES;
                    }
                } catch (NumberFormatException e) {
                    System.out.println("Invalid interval. Using default: " + DEFAULT_INTERVAL_MINUTES + " minutes");
                }
            }

            robot = new Robot();

            System.out.println("=== Keep MS Teams Active ===");
            System.out.println("Activity interval: " + intervalMinutes + " minute(s)");
            System.out.println("Program started at: " + new java.util.Date());
            System.out.println("Press Ctrl+C to stop");
            System.out.println("============================\n");

            long intervalMillis = TimeUnit.MINUTES.toMillis(intervalMinutes);
            int activityCount = 0;

            while (true) {
                activityCount++;
                performActivity(activityCount);

                System.out.println("Next activity in " + intervalMinutes + " minute(s)...\n");
                Thread.sleep(intervalMillis);
            }

        } catch (AWTException e) {
            System.err.println("Error: Unable to create Robot instance");
            System.err.println("Make sure you have the necessary permissions");
            e.printStackTrace();
        } catch (InterruptedException e) {
            System.out.println("\nProgram interrupted. Exiting...");
        }
    }

    /**
     * Performs simulated user activity
     */
    private static void performActivity(int count) {
        System.out.println("[" + new java.util.Date() + "] Activity #" + count);

        // Randomly choose activity type
        int activityType = random.nextInt(3);

        switch (activityType) {
            case 0:
                moveMouseRandomly();
                break;
            case 1:
                pressShiftKey();
                break;
            case 2:
                moveMouseAndPressKey();
                break;
        }
    }

    private static void moveMouseRandomly() {
        System.out.println("Action: Moving mouse randomly");

        Point currentPos = MouseInfo.getPointerInfo().getLocation();
        int startX = currentPos.x;
        int startY = currentPos.y;

        for (int i = 0; i < 4; i++) {
            int offsetX = random.nextInt(100) - 50;
            int offsetY = random.nextInt(100) - 50;

            robot.mouseMove(startX + offsetX, startY + offsetY);
            robot.delay(100);
        }

        robot.mouseMove(startX, startY);
        System.out.println("Mouse movement completed");
    }

    private static void pressShiftKey() {
        System.out.println("Action: Pressing Shift key");

        robot.keyPress(KeyEvent.VK_SHIFT);
        robot.delay(50);
        robot.keyRelease(KeyEvent.VK_SHIFT);

        System.out.println("Shift key pressed");
    }

    private static void moveMouseAndPressKey() {
        System.out.println("Action: Moving mouse + pressing key");

        Point currentPos = MouseInfo.getPointerInfo().getLocation();

        robot.mouseMove(currentPos.x + 10, currentPos.y + 10);
        robot.delay(50);
        robot.mouseMove(currentPos.x, currentPos.y);

        robot.keyPress(KeyEvent.VK_SCROLL_LOCK);
        robot.delay(50);
        robot.keyRelease(KeyEvent.VK_SCROLL_LOCK);
        robot.delay(50);
        robot.keyPress(KeyEvent.VK_SCROLL_LOCK);
        robot.delay(50);
        robot.keyRelease(KeyEvent.VK_SCROLL_LOCK);

        System.out.println("Combined activity completed");
    }
}
