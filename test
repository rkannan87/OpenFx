private static final Pattern SAFE_CUST_CODE = Pattern.compile("^[A-Za-z0-9_-]+$");

private void validateCustCode(String custCode) throws DatacomException {
    if (custCode == null || !SAFE_CUST_CODE.matcher(custCode).matches()) {
        throw new DatacomException("Invalid customer code: " + custCode);
    }
}
