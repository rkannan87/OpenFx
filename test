import com.sun.jna.Native;
import com.sun.jna.Library;
import com.sun.jna.platform.win32.WinDef.HWND;
import com.sun.jna.win32.W32APIOptions;

import java.awt.AWTException;
import java.awt.MouseInfo;
import java.awt.Point;
import java.awt.Robot;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.Random;
import java.util.concurrent.Executors;
import java.util.concurrent.ScheduledExecutorService;
import java.util.concurrent.TimeUnit;

/**
 * KeepEdgeActive
 * --------------
 * Periodically simulates minimal, harmless user input (a tiny mouse nudge)
 * ONLY when Microsoft Edge is the foreground (focused) window, so that a
 * website session does not time out due to inactivity.
 *
 * Design notes:
 *  - Does NOT send page refresh / navigation keys by default, because a
 *    forced refresh can lose form state or trigger re-authentication on
 *    some banking/enterprise sites. Instead it moves the mouse pointer by a
 *    small random offset (and back to its original spot) each cycle, which
 *    resets client-side and server-side idle timers that rely on standard
 *    browser activity events (mousemove) without dragging, clicking, or
 *    otherwise interacting with page content.
 *  - Only acts when Edge is focused, so it won't steal input from whatever
 *    else you're working in.
 *  - Requires the JNA and jna-platform jars on the classpath.
 *
 * Build/run:
 *   javac -cp jna-5.14.0.jar;jna-platform-5.14.0.jar KeepEdgeActive.java
 *   java  -cp .;jna-5.14.0.jar;jna-platform-5.14.0.jar KeepEdgeActive
 *
 * Configure INTERVAL_SECONDS and WINDOW_TITLE_FILTER below as needed.
 */
public class KeepEdgeActive {

    // How often to check/nudge. Keep below the site's idle-timeout window
    // (e.g., if the site times out at 5 minutes, use 120-180 seconds).
    private static final int INTERVAL_SECONDS = 120;

    // Only nudge if the foreground window title contains this text.
    // "Edge" appears in Edge's window title on most Windows builds; you can
    // narrow this to your site's tab title (e.g., "Scotiabank") to be safer.
    private static final String WINDOW_TITLE_FILTER = "Edge";

    private static final DateTimeFormatter TS = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
    private static final Random RANDOM = new Random();

    // Minimal JNA binding for the two user32 calls we need.
    public interface User32Ext extends Library {
        User32Ext INSTANCE = Native.load("user32", User32Ext.class, W32APIOptions.DEFAULT_OPTIONS);

        HWND GetForegroundWindow();

        int GetWindowTextW(HWND hWnd, char[] lpString, int nMaxCount);
    }

    public static void main(String[] args) throws AWTException {
        Robot robot = new Robot();
        robot.setAutoWaitForIdle(true);

        ScheduledExecutorService scheduler = Executors.newSingleThreadScheduledExecutor(r -> {
            Thread t = new Thread(r, "keep-edge-active");
            t.setDaemon(true);
            return t;
        });

        log("Started. Checking every " + INTERVAL_SECONDS + "s for foreground window containing \""
                + WINDOW_TITLE_FILTER + "\".");

        scheduler.scheduleAtFixedRate(() -> {
            try {
                String activeTitle = getForegroundWindowTitle();
                if (activeTitle != null && activeTitle.toLowerCase().contains(WINDOW_TITLE_FILTER.toLowerCase())) {
                    nudgeMouseRandom(robot);
                    log("Edge active (\"" + activeTitle + "\") -> moved cursor randomly to keep session alive.");
                } else {
                    log("Edge not focused (active: \"" + activeTitle + "\") -> skipped.");
                }
            } catch (Exception e) {
                log("Error during activity check: " + e.getMessage());
            }
        }, 0, INTERVAL_SECONDS, TimeUnit.SECONDS);

        // Keep the JVM alive. Ctrl+C to stop.
        try {
            Thread.currentThread().join();
        } catch (InterruptedException ignored) {
            Thread.currentThread().interrupt();
        }
    }

    private static String getForegroundWindowTitle() {
        HWND hwnd = User32Ext.INSTANCE.GetForegroundWindow();
        if (hwnd == null) {
            return null;
        }
        char[] buffer = new char[512];
        int len = User32Ext.INSTANCE.GetWindowTextW(hwnd, buffer, buffer.length);
        return new String(buffer, 0, len);
    }

    private static void nudgeMouseRandom(Robot robot) {
        Point p = MouseInfo.getPointerInfo().getLocation();
        int x = p.x;
        int y = p.y;

        // Pick a random offset in each direction, e.g. -15..15 px, skipping 0
        // so it always actually moves.
        int dx = randomOffset(15);
        int dy = randomOffset(15);

        robot.mouseMove(x + dx, y + dy);
        robot.delay(80);
        // Move back to the original spot so the cursor doesn't drift away
        // over time.
        robot.mouseMove(x, y);
    }

    private static int randomOffset(int maxAbs) {
        int value = RANDOM.nextInt(maxAbs * 2 + 1) - maxAbs; // range: -maxAbs..maxAbs
        return value == 0 ? 1 : value;
    }

    private static void log(String message) {
        System.out.println("[" + LocalDateTime.now().format(TS) + "] " + message);
    }
}
