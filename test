private Map<String, String> resolvePlainPanMapForOutput(String keyLocation, String outFileName) {
    Map<String, String> plainPanMap = PanSubstitutionService.buildPlainPanMapForOutput(keyLocation);
    if (plainPanMap.isEmpty()) {
        log.debug("no cached PAN data for [{}], skipping .out.EncPan.csv", keyLocation);
        return plainPanMap;
    }

    // Only ship indices that actually made it into the final .out file
    plainPanMap = PanSubstitutionService.filterToIndicesPresentInOutput(keyLocation, outFileName, plainPanMap);
    if (plainPanMap.isEmpty()) {
        log.debug("no PAN indices present in output file [{}], skipping .out.EncPan.csv", outFileName);
    }
    return plainPanMap;
}

private Map<String, String> buildEncryptedMap(String keyLocation, String vaultKeyLocation, Map<String, String> plainPanMap) {
    PanDecryptService decryptService = PanDecryptServiceHolder.getInstance();
    return PanSubstitutionService.buildOutputCiphertextMap(keyLocation, plainPanMap, vaultKeyLocation, decryptService);
}

private void writeEncPanCsv(String outFileName, String csvPathForOutputLayout, String keyLocation, Map<String, String> encryptedMap) {
    int[] outputAccountFieldInfo = PanSubstitutionService.getOutputAccountFieldInfo(csvPathForOutputLayout);
    String encPanOutPath = outFileName + ".EncPan.csv";
    EncPanCsvWriter.write(encPanOutPath, keyLocation, encryptedMap, outputAccountFieldInfo);
}
