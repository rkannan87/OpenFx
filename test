/**
 * Generate a companion .out.EncPan.csv file if PAN substitution was used.
 * Reads the job-wide keyLocation directly off the Job entity (set once by
 * ChunkGeneratorController.postChunks) rather than resolving it from a
 * search-phase CSV on disk. Falls back to intermediate-CSV recovery if the
 * job's keyLocation is unset (older jobs) or the in-memory cache is cold
 * (e.g. after a JVM restart mid-job).
 *
 * @param custCode    company code
 * @param outFileName absolute path to the assembled .out ship file
 * @param job         the Job entity (carries panKeyLocation)
 */
private void generateEncPanCsv(String custCode, String outFileName, Job job) {
    String keyLocation = job.getPanKeyLocation();

    if (keyLocation == null) {
        log.warn("no panKeyLocation on job [{}], attempting intermediate CSV recovery", job.getId());
        recoverFromIntermediateCsvs(custCode, outFileName);
        return;
    }

    Map<String, String> plainPanMap = resolvePlainPanMapForOutput(keyLocation, outFileName);
    if (!plainPanMap.isEmpty()) {
        Map<String, String> encryptedMap = buildEncryptedMap(keyLocation, keyLocation, plainPanMap);
        if (!encryptedMap.isEmpty()) {
            writeEncPanCsv(outFileName, keyLocation, keyLocation, encryptedMap);
            finalizeJob(custCode, keyLocation, null);
            return;
        }
        log.warn("encrypted map empty for [{}], attempting intermediate CSV recovery", keyLocation);
    } else {
        log.warn("warm cache empty for [{}], attempting intermediate CSV recovery", keyLocation);
    }

    recoverFromIntermediateCsvs(custCode, outFileName);
}
