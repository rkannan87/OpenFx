3. PanRestorationHelper.java — complete file

package ca.tuc.triggers.processor.pan;

import java.util.List;
import lombok.extern.slf4j.Slf4j;

/**
 * Utility for substituting realPan -> INDEX in DTOs and consumer row strings.
 * All substitution is keyed by a job-wide keyLocation (generated once per job
 * by ChunkGeneratorController.postChunks). Since keyLocation is always fresh
 * for a job, every PAN encountered is "unknown" to PanSubstitutionService's
 * caches the first time it's seen within that job, and mints a new sequential
 * INDEX starting at 1 - subsequent occurrences of the same PAN within the
 * same job reuse that INDEX via PanSubstitutionService's internal dedup.
 */
@Slf4j
public final class PanRestorationHelper {

    private PanRestorationHelper() {
    }

    /**
     * Substitute the account number in a serialized |AC| row with a job-wide
     * consistent sequential INDEX, without mutating any DTO. acctNum is 3
     * tokens after the "AC" token (AC|subId|ref|acctNum).
     *
     * @param row         the raw row string
     * @param keyLocation job-wide key-location (from cm.getEncPanCsvPath())
     * @param fieldLength the customer's account field length for zero-padding
     * @return the row with acctNum replaced by its sequential INDEX
     */
    public static String substituteAcctNumInRow(String row, String keyLocation, int fieldLength) {
        if (row == null || keyLocation == null || !row.contains("|AC|")) {
            return row;
        }

        String[] cols = row.split("\\|", -1);

        int acIdx = -1;
        for (int i = 0; i < cols.length; i++) {
            if ("AC".equals(cols[i].trim())) { acIdx = i; break; }
        }
        if (acIdx == -1) return row;

        int acctNumIdx = acIdx + 3;
        if (acctNumIdx >= cols.length) return row;

        String acctNum = cols[acctNumIdx].trim();
        if (acctNum.isEmpty()) return row;

        String seqIndex = PanSubstitutionService.getOrCreateSeqIndexForUnknownPan(keyLocation, acctNum, fieldLength);
        if (seqIndex == null) return row;

        int padLen = cols[acctNumIdx].length();
        cols[acctNumIdx] = String.format("%-" + padLen + "s", seqIndex);

        log.debug("txt: realPan -> seqIndex [{}] col [{}]", seqIndex, acctNumIdx);
        return String.join("|", cols);
    }

    /**
     * Substitute every |AC| line within a multi-line block (TriggeredResultWrapper
     * output / |TD| notification rows). Preserves line separators.
     *
     * @param block       multi-line block, possibly containing |AC| lines
     * @param keyLocation job-wide key-location (from cm.getEncPanCsvPath())
     * @param fieldLength the customer's account field length for zero-padding
     * @return the block with every |AC| line's acctNum replaced by its sequential INDEX
     */
    public static String substituteAcLinesInBlock(String block, String keyLocation, int fieldLength) {
        if (block == null || !block.contains("|AC|")) {
            return block;
        }

        StringBuilder out = new StringBuilder(block.length() + 16);
        int start = 0;
        int len = block.length();

        while (start < len) {
            int nl = block.indexOf('\n', start);
            int contentEnd = (nl < 0) ? len : nl;
            boolean hasCr = (contentEnd > start && block.charAt(contentEnd - 1) == '\r');
            if (hasCr) contentEnd--;

            String line = block.substring(start, contentEnd);
            if (line.contains("|AC|")) {
                line = substituteAcctNumInRow(line, keyLocation, fieldLength);
            }

            out.append(line);
            if (hasCr) out.append('\r');
            if (nl >= 0) out.append('\n');

            start = (nl < 0) ? len : nl + 1;
        }
        return out.toString();
    }

    /**
     * Substitute the account field in a cinquiry consumer row string, realPan
     * -> sequential INDEX.
     *
     * @param consumer      the raw consumer row string from cinquiry
     * @param accountOffset the input offset of the account field
     * @param accountLength the length of the account field
     * @param keyLocation   job-wide key-location (from cm.getEncPanCsvPath())
     * @return the consumer string with the account field set to its sequential INDEX
     */
    public static String substituteConsumerRow(String consumer, int accountOffset, int accountLength, String keyLocation) {
        if (consumer == null || keyLocation == null) {
            return consumer;
        }
        if (consumer.length() < accountOffset + accountLength) {
            log.warn("consumer row too short for account field at offset={} length={} consumer.length={}",
                accountOffset, accountLength, consumer.length());
            return consumer;
        }

        String realPan = consumer.substring(accountOffset, accountOffset + accountLength).trim();
        if (realPan.isEmpty()) {
            return consumer;
        }

        String seqIndex = PanSubstitutionService.getOrCreateSeqIndexForUnknownPan(keyLocation, realPan, accountLength);
        if (seqIndex == null) {
            return consumer;
        }

        char[] padded = new char[accountLength];
        java.util.Arrays.fill(padded, ' ');
        int copyLen = Math.min(seqIndex.length(), accountLength);
        seqIndex.getChars(0, copyLen, padded, 0);

        StringBuilder sb = new StringBuilder(consumer);
        sb.replace(accountOffset, accountOffset + accountLength, new String(padded));

        log.debug("substituted consumer row account field to sequential INDEX [{}]", seqIndex);
        return sb.toString();
    }

    /**
     * Substitute IndicBaseDto.accountNumber from realPan -> sequential INDEX
     * for a flat list of DTOs (used in Stage 4 FullfillerDefault).
     *
     * @param dtos        list of IndicBaseDto
     * @param keyLocation job-wide key-location (from cm.getEncPanCsvPath())
     * @param fieldLength the customer's account field length for zero-padding
     */
    public static void substituteIndicDtoList(List<IndicBaseDto> dtos, String keyLocation, int fieldLength) {
        if (dtos == null || keyLocation == null) {
            return;
        }
        for (IndicBaseDto dto : dtos) {
            if (dto instanceof IndicAccountDto) {
                IndicAccountDto acct = (IndicAccountDto) dto;
                String pan = acct.getAcctNum();
                if (pan == null || pan.trim().isEmpty()) continue;

                String seqIndex = PanSubstitutionService.getOrCreateSeqIndexForUnknownPan(keyLocation, pan.trim(), fieldLength);
                if (seqIndex != null) {
                    acct.setAcctNum(seqIndex);
                }
            }
        }
    }
}
(Imports needed: ca.tuc.commons.dto.schema.indic.IndicBaseDto, ca.tuc.commons.dto.schema.indic.IndicAccountDto — matching what FullfillerDefault already references via ListDtoHelper.getByType(dtoSegments, "ca.tuc.commons.dto.schema.indic.IndicBaseDto").)

